---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts, postUrl } from "@/lib/content";

const posts = await getPublishedPosts();
const random = posts[Math.floor(Math.random() * posts.length)];
---

<BaseLayout title="页面不存在 - NexaBlog" description="这个页面不存在。">
  <section class="narrow">
    <p class="eyebrow">404</p>
    <h1>这个页面还没有被写出来。</h1>
    <p class="hero-copy">也可能是链接过期了。回到文章列表或搜索页，通常能重新找到那条线索。</p>
    <div class="tag-list" style="margin-top: var(--space-6)">
      <a class="tag" href="/articles/">全部文章</a>
      <a class="tag" href="/search/">搜索</a>
      <a class="tag" href="/">回首页</a>
    </div>
    {random && (
      <div class="quiet-panel" style="margin-top: var(--space-8)">
        <p class="meta">也许你会感兴趣</p>
        <h3 style="margin-top: var(--space-2)"><a href={postUrl(random)}>{random.data.title}</a></h3>
        <p class="meta">{random.data.description}</p>
      </div>
    )}
  </section>
</BaseLayout>

