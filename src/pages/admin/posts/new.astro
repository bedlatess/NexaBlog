---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminEditorForm from "@/components/AdminEditorForm.astro";
---

<BaseLayout title="新建文章 - NexaBlog" description="在 NexaBlog 后台创建 Supabase 草稿。">
  <section class="container admin-editor-shell">
    <div class="editor-page-head">
      <p class="eyebrow">New Post</p>
      <h1>新建文章</h1>
      <p class="hero-copy">写作、预览、发布检查集中在一个工作台里。</p>
    </div>
    <AdminEditorForm mode="new" />
  </section>
  <script>
    import "@/scripts/admin-editor";
  </script>
</BaseLayout>
