---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { integrations } from "@/data/integrations";
---

<BaseLayout title="后台 - NexaBlog" description="NexaBlog 管理后台">
  <section class="container admin-shell">
    <div class="admin-header">
      <div>
        <p class="eyebrow">Admin</p>
        <h1>文章管理</h1>
      </div>
      <div class="tag-list">
        <a class="button" href="/admin/posts/new/">新建文章</a>
        <a class="tag" href="/" target="_blank">查看前台</a>
      </div>
    </div>

    <section class="quiet-panel" data-admin-live>
      <div class="admin-header" style="margin: 0 0 var(--space-6)">
        <div>
          <p class="meta" data-admin-live-message>正在连接...</p>
          <p class="meta">登录账号：<span data-admin-session>未登录</span></p>
        </div>
        <div class="tag-list">
          <button class="tag" type="button" data-admin-export-json>导出 JSON</button>
          <button class="tag" type="button" data-admin-export-markdown>导出 Markdown</button>
          <button class="tag" type="button" data-admin-import-json>导入 JSON</button>
          <input type="file" accept="application/json,.json" data-admin-import-file hidden />
          <button class="tag warning-action" type="button" data-admin-logout>退出登录</button>
        </div>
      </div>

      <div class="admin-stats-row" aria-label="文章统计">
        <div class="stat-card">
          <small>总计</small>
          <strong data-admin-live-count="total">-</strong>
        </div>
        <div class="stat-card">
          <small>已发布</small>
          <strong data-admin-live-count="published">-</strong>
        </div>
        <div class="stat-card">
          <small>草稿</small>
          <strong data-admin-live-count="draft">-</strong>
        </div>
        <div class="stat-card">
          <small>最近更新</small>
          <strong data-admin-live-count="latest">-</strong>
        </div>
      </div>

      <div class="admin-filter-bar" data-admin-post-filters>
        <input class="admin-input" type="search" placeholder="搜索标题、摘要或标签" data-admin-post-search />
        <select class="admin-input" data-admin-post-tag aria-label="按标签筛选">
          <option value="all">全部标签</option>
        </select>
        <select class="admin-input" data-admin-post-sort aria-label="排序">
          <option value="updated-desc">最近更新</option>
          <option value="published-desc">最近发布</option>
          <option value="title-asc">标题 A-Z</option>
          <option value="draft-first">草稿优先</option>
        </select>
        <div class="segmented-control" aria-label="文章状态">
          <button type="button" data-admin-post-status="all" aria-pressed="true">全部</button>
          <button type="button" data-admin-post-status="published">已发布</button>
          <button type="button" data-admin-post-status="draft">草稿</button>
        </div>
      </div>

      <div class="admin-list" data-admin-live-posts>
        <div class="admin-row">
          <span>
            <strong>等待连接</strong>
            <small>正在读取文章列表...</small>
          </span>
        </div>
      </div>
    </section>

    {!integrations.supabase.enabled && (
      <section class="quiet-panel">
        <p class="eyebrow">Setup</p>
        <h2>首次配置</h2>
        <p>后台需要 Supabase 才能工作。请按以下步骤配置：</p>
        <ol class="admin-steps">
          <li>在 <a href="https://supabase.com" target="_blank">supabase.com</a> 创建项目</li>
          <li>在 Supabase SQL 编辑器执行 <code>supabase/schema.sql</code></li>
          <li>在 Vercel 环境变量里添加 <code>PUBLIC_SUPABASE_URL</code> 和 <code>PUBLIC_SUPABASE_ANON_KEY</code></li>
          <li>重新部署后回到这里登录</li>
        </ol>
      </section>
    )}
  </section>
  <script>
    import "@/scripts/admin-dashboard";
  </script>
</BaseLayout>
