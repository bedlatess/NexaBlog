---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags, getPublishedPosts } from "@/lib/content";
import { site } from "@/data/site";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title={`标签 - ${site.name}`} description={`按主题浏览 ${site.name}。`}>
  <section class="narrow">
    <p class="eyebrow">Tags</p>
    <h1>标签云</h1>
    <p class="hero-copy">标签不是分类柜，而是思想之间的轻量索引。</p>
    <div class="quiet-panel" style="margin-top: var(--space-8)">
      <div class="tag-list">
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${tag.slug}/`}>#{tag.label} · {tag.count}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

