---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleIntegrations from "@/components/ArticleIntegrations.astro";
import { render } from "astro:content";
import { getPublishedPosts, formatDate, getReadingTime, postSlug, postUrl } from "@/lib/content";
import { tagSlug } from "@/lib/tags";
import { site } from "@/data/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: { post, prev: posts[index + 1] ?? null, next: posts[index - 1] ?? null }
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const updated =
  post.data.updated && post.data.updated.getTime() !== post.data.published.getTime()
    ? post.data.updated
    : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  dateModified: (updated ?? post.data.published).toISOString(),
  author: { "@type": "Person", name: site.author },
  keywords: post.data.tags,
  url: new URL(postUrl(post), site.url).toString(),
  mainEntityOfPage: { "@type": "WebPage", "@id": new URL(postUrl(post), site.url).toString() }
};
---

<BaseLayout
  title={`${post.data.title} - ${site.name}`}
  description={post.data.description}
  image={post.data.cover?.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <meta property="og:type" content="article" slot="head" />
  <meta property="article:published_time" content={post.data.published.toISOString()} slot="head" />
  {updated && <meta property="article:modified_time" content={updated.toISOString()} slot="head" />}
  {post.data.tags.map((tag) => <meta property="article:tag" content={tag} slot="head" />)}

  <div class="reading-progress" data-reading-progress aria-hidden="true" data-pagefind-ignore></div>
  <div class="container article-shell">
    <article data-pagefind-body>
      <header class="article-header">
        <p class="eyebrow" data-pagefind-ignore>Article</p>
        {post.data.cover?.image && (
          <div class="article-cover-image" data-pagefind-ignore>
            <img src={post.data.cover.image} alt={post.data.cover.label ?? post.data.title} loading="eager" decoding="async" />
          </div>
        )}
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-description" data-pagefind-meta="description">{post.data.description}</p>
        <p class="meta" data-pagefind-ignore>
          发布于 {formatDate(post.data.published)} · {getReadingTime(post.body)}
          {updated && <> · 更新于 {formatDate(updated)}</>}
        </p>
        <div class="tag-list" style="margin-top: var(--space-4)">
          {post.data.tags.map((tag) => (
            <a class="tag" href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
          ))}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <ArticleIntegrations />
    </article>

    <aside class="toc" aria-label="文章目录">
      <p class="toc-title">目录</p>
      {toc.length ? (
        toc.map((heading) => (
          <a href={`#${heading.slug}`} style={`padding-left: ${(heading.depth - 2) * 12}px`}>
            {heading.text}
          </a>
        ))
      ) : (
        <p class="meta">这篇文章很短。</p>
      )}
    </aside>
  </div>

  <button class="icon-button back-to-top" type="button" data-back-to-top aria-label="回到顶部">↑</button>

  {(prev || next) && (
    <nav class="container article-nav" aria-label="文章导航">
      {prev ? (
        <a class="article-nav-link" href={postUrl(prev)}>
          <span class="meta">← 上一篇</span>
          <span>{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="article-nav-link article-nav-next" href={postUrl(next)}>
          <span class="meta">下一篇 →</span>
          <span>{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  )}

  <script src="/scripts/article.js" defer></script>
</BaseLayout>
