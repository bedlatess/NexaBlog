---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts, getAllTags } from "@/lib/content";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="关于 - NexaBlog" description="关于 NexaBlog 演示站和作者 PAWN。">
  <section class="narrow">
    <p class="eyebrow">About</p>
    <h1>关于本站</h1>
    <div class="prose">
      <p>
        独立开发者。关注产品思维、设计系统和工程美学在实践中如何互相约束、互相成就。
      </p>
      <p>
        这里记录的不是教程，而是做东西过程中真实遇到的判断：为什么选这个架构、为什么放弃那个方案、什么时候克制比添加更难。
      </p>
      <h2>写作方向</h2>
      <ul>
        <li>产品决策背后的工程取舍</li>
        <li>设计系统的边界与自律</li>
        <li>写作体验与信息架构</li>
        <li>独立开发的工具链与工作流</li>
      </ul>
      <h2>站点数据</h2>
      <p>
        当前共有 {posts.length} 篇文章，覆盖 {tags.length} 个标签。
      </p>
      <h2>联系</h2>
      <p>
        Telegram：<a href="https://t.me/bedlate" target="_blank" rel="noreferrer">@bedlate</a>
      </p>
    </div>
  </section>
</BaseLayout>
