---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { friends } from "@/data/links";
---

<BaseLayout title="友链 - PAWN" description="PAWN 的友链与推荐。">
  <section class="container">
    <p class="eyebrow">Links</p>
    <h1>友链</h1>
    <p class="hero-copy">这里既可以放朋友，也可以放这个项目依赖的思想来源。欢迎交换友链。</p>
    <div class="article-grid" style="margin-top: var(--space-8)">
      {friends.map((link) => (
        <a class="article-card" href={link.url} target="_blank" rel="noreferrer">
          <div>
            <p class="meta">External</p>
            <h3>{link.name}</h3>
            <p>{link.description}</p>
          </div>
          <span class="tag">访问 ↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

